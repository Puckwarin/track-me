+  // ใช้วันที่เป็น id → 1 วัน = 1 บันทึก บันทึกซ้ำคือแก้ไขของเดิม
+  setDoc(userDoc(state.uid, 'symptom_records', date), {
+    date, symptoms, mood: num('s-mood'), stress: num('s-stress'), note: $('#s-note', root).value.trim(), updatedAt: new Date()
