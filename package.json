{
  "name": "track-me",
  "version": "5.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "eslint src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:rules": "firebase emulators:exec --project track-me-rules-test --only firestore \"vitest run src/firestoreRules.test.js\"",
    "test:watch": "vitest",
    "lock:check": "node scripts/check-lockfile.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "firebase-tools": "^15.36.0",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.5",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/prompt": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "firebase": "^13.3.0",
    "tesseract.js": "^7.0.0"
  }
}
