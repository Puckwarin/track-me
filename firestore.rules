rules_version = '2';

// กฎชุดสุดท้าย (ใช้งานจริง): ผู้ใช้เข้าถึงได้เฉพาะข้อมูลใต้ users/{uid} ของตัวเอง
// ทุกอย่างนอกเหนือจากนี้ (รวมข้อมูลแบบ Room Code เดิม) ถูกปฏิเสธ
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function knownCollection(c) {
      return c in ['food_records', 'period_records', 'body_records', 'symptom_records', 'custom_foods', 'skincare_products', 'skin_records', 'ingredient_blacklist', 'pet_profiles', 'pet_care_records', 'pet_food_records', 'tracked_products', 'replacement_records', 'workout_records', 'workout_templates', 'expense_records', 'settings', 'lab_records'];
    }
    function optionalString(data, field) {
      return !(field in data) || data[field] == null || data[field] is string;
    }
    function optionalStringOrTimestamp(data, field) {
      return !(field in data) || data[field] == null
             || data[field] is string || data[field] is timestamp;
    }
    function optionalNumber(data, field) {
      return !(field in data) || data[field] == null
             || data[field] is int || data[field] is float;
    }
    function optionalBoolean(data, field) {
      return !(field in data) || data[field] == null || data[field] is bool;
    }
    function optionalMap(data, field) {
      return !(field in data) || data[field] == null || data[field] is map;
    }
    function validCommonFieldTypes(data, uid) {
      return (!('uid' in data) || data.uid == uid)
        && optionalString(data, 'date')
        && optionalString(data, 'start')
        && optionalString(data, 'end')
        && optionalString(data, 'nextDate')
        && optionalStringOrTimestamp(data, 'createdAt')
        && optionalStringOrTimestamp(data, 'updatedAt')
        && optionalString(data, 'name')
        && optionalString(data, 'category')
        && optionalString(data, 'type')
        && optionalString(data, 'note')
        && optionalString(data, 'source')
        && optionalString(data, 'status')
        && optionalString(data, 'dueTime')
        && optionalNumber(data, 'amount')
        && optionalNumber(data, 'calories')
        && optionalNumber(data, 'value')
        && optionalNumber(data, 'weight')
        && optionalBoolean(data, 'done')
        && optionalMap(data, 'symptoms');
    }
    match /users/{uid}/{collection}/{recordId} {
      allow read, delete: if isOwner(uid) && knownCollection(collection);
      allow create, update: if isOwner(uid) && knownCollection(collection)
                            && request.resource.data.keys().size() <= 30
                            && validCommonFieldTypes(request.resource.data, uid);
    }
  }
}
