From 3b58e4d3d4308461ec3a75a65adc6a94f656cbd5 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 20 Nov 2026 04:55:35 +0000
Subject: [PATCH] ui: reduce floating-button clutter, surface weekly/report
 from overview, reorder home widgets, add subnav scroll affordance

---
 index.html                     |  5 +----
 src/app.js                     |  9 ++++++++-
 src/home.js                    |  6 +++---
 src/homeWidgetContract.test.js |  6 +++---
 src/overview.js                |  6 ++++++
 src/style.css                  | 11 +++++++++++
 6 files changed, 32 insertions(+), 11 deletions(-)

diff --git a/index.html b/index.html
index 97b5dce..a39dc4b 100644
--- a/index.html
+++ b/index.html
@@ -189,13 +189,10 @@
     </div>
 
     <!-- ปุ่มลอยเลื่อนขึ้นบนสุด / ลงล่างสุด -->
-    <div id="scroll-fabs" class="scroll-fabs no-print" aria-label="ตัวช่วยเลื่อนหน้าจอ">
+    <div id="scroll-fabs" class="scroll-fabs no-print is-hidden" aria-label="เลื่อนขึ้นบนสุด">
       <button id="fab-top" type="button" class="fab-scroll-btn" aria-label="เลื่อนขึ้นบนสุด" title="ขึ้นบนสุด">
         <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 18.5V5.5m0 0-5 5m5-5 5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
       </button>
-      <button id="fab-bottom" type="button" class="fab-scroll-btn" aria-label="เลื่อนลงล่างสุด" title="ลงล่างสุด">
-        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5.5v13m0 0-5-5m5 5 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
-      </button>
     </div>
   </div>
 
diff --git a/src/app.js b/src/app.js
index dd3c41f..c31f343 100644
--- a/src/app.js
+++ b/src/app.js
@@ -495,12 +495,19 @@ on('auth', user => {
 
 document.querySelectorAll('[data-nav]').forEach(b => b.addEventListener('click', () => goToGroup(b.dataset.nav)));
 $('#subnav').addEventListener('click', e => { const b = e.target.closest('[data-sub]'); if (b) goTo(b.dataset.sub); });
+window.addEventListener('trackme:goto', e => { if (e.detail?.tab) goTo(e.detail.tab); });
 $('#btn-logo').addEventListener('click', () => goTo('home'));
 $('#btn-bell').addEventListener('click', () => goTo('notifications'));
 $('#btn-settings').addEventListener('click', () => goTo('settings'));
 $('#btn-copy-summary').addEventListener('click', copySummary);
 $('#fab-top')?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
-$('#fab-bottom')?.addEventListener('click', () => window.scrollTo({ top: Math.max(document.body.scrollHeight, document.documentElement.scrollHeight), behavior: 'smooth' }));
+// ปุ่ม "ขึ้นบนสุด" โผล่เฉพาะตอนเลื่อนลงไปพอสมควร ไม่ใช่ลอยค้างตลอดเวลา
+const scrollFabs = $('#scroll-fabs');
+if (scrollFabs) {
+  const toggleScrollFab = () => scrollFabs.classList.toggle('is-hidden', window.scrollY < 400);
+  window.addEventListener('scroll', toggleScrollFab, { passive: true });
+  toggleScrollFab();
+}
 $('#btn-quick-add').addEventListener('click', openQuick);
 $('#quick-close').addEventListener('click', closeQuick);
 $('#quick-sheet').addEventListener('click', e => {
